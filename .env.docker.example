# 复制为 .env 后由 docker compose 读取（与 docker-compose.yml 同目录）
# cp .env.docker.example .env

MYSQL_DATABASE=auto_amazon
MYSQL_USER=auto_amazon
# 数据库密码只能使用 ASCII。若宿主机 shell 曾 export MYSQL_PASSWORD=中文，会覆盖 compose 里对 ${MYSQL_PASSWORD} 的替换并导致 PyMySQL 报错；当前 compose 已改为只读 .env 注入。
MYSQL_PASSWORD=ChangeMe_AppUser_9xK2
MYSQL_ROOT_PASSWORD=ChangeMe_Root_7mQ4

# 宿主机访问 Nginx 的端口
HTTP_PORT=8080

# Django CSRF 受信任来源（逗号分隔，必须带 http/https，端口与 HTTP_PORT 一致）
# 必须写成浏览器地址栏里实际访问的地址，IP/域名错了会 403 CSRF
# 示例：http://192.168.11.134:8080  多个用英文逗号：http://a:8080,http://b:8080
CSRF_TRUSTED_ORIGINS=http://192.168.11.134:8080

# 定时任务（scheduler 容器每小时扫描一次到期 ASIN）
SCHEDULER_ENABLED=true
PRIORITY_ROI_INTERVAL_DAYS=7
PRIORITY_AD_INTERVAL_DAYS=7
# 定时任务合并批次：当天各时段到期的 ASIN 统一在 23 点窗口执行（先 ROI 后广告难度）
SCHEDULER_BATCH_MODE=true
SCHEDULER_BATCH_HOUR=23
SCHEDULER_BATCH_WINDOW_HOURS=2
USD_CNY_RATE_FALLBACK=7.2

# 定时任务 / 广告难度批量并发（每个 ASIN 独立请求，默认 4）
ROI_SCHEDULER_ASIN_MAX_CONCURRENT=6

# ROI 双队列：少于 20 个 ASIN 走单次账号+Worker，≥20 走大批量账号+Worker
ROI_BULK_ASIN_THRESHOLD=20
# 批量账号被禁后冷却天数（解禁后不再立即使用）
ROI_BULK_ACCOUNT_COOLDOWN_DAYS=3
RQ_QUEUE_ROI_SINGLE=roi_single
RQ_QUEUE_ROI_BULK=roi_bulk
